# BennCo Advisors - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://myuser:mypassword@localhost:5432/bennco_advisors
DATABASE_URL=postgresql://username:password@host:port/database

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SendGrid API Key (recommended)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# The key should start with "SG."
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Alternative: Custom SMTP Configuration (if not using SendGrid)
# Uncomment and fill these if you want to use a different email service
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@domain.com
# EMAIL_PASS=your_email_password

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Node environment: development or production
NODE_ENV=production

# Port for the server (default: 5000)
# Note: Some hosting providers set this automatically
PORT=5000

# =============================================================================
# NOTES FOR DEPLOYMENT
# =============================================================================
# 1. NEVER commit your .env file to version control (it's in .gitignore)
# 2. Set these variables in your hosting provider's dashboard
# 3. DATABASE_URL is required - the app will not start without it
# 4. Either SENDGRID_API_KEY or EMAIL_HOST/USER/PASS is required for contact forms
# 5. Most hosting providers set NODE_ENV and PORT automatically
